+
+static int ub_validate_route_override(struct ub_entity *src,
+				      struct ub_entity *relay,
+				      struct ub_entity *dst)
+{
+	struct ub_port *src_to_relay, *relay_port;
+	bool relay_reaches_dst = false;
+
+	if (src == relay || src == dst || relay == dst)
+		return -EINVAL;
+	src_to_relay = ub_find_unique_port_to_uent(src, relay->uent_num);
+	if (IS_ERR(src_to_relay))
+		return PTR_ERR(src_to_relay);
+	for_each_uent_port(relay_port, relay) {
+		if (!test_bit(dst->cna, relay_port->cna_maps))
+			continue;
+		if (relay_port->r_uent == src)
+			continue;
+		relay_reaches_dst = true;
+		break;
+	}
+	return relay_reaches_dst ? 0 : -EHOSTUNREACH;
+}
+
+static int ub_mark_cna_for_sync(struct ub_entity *uent, u32 cna)
+{
+	struct cna_node *node = ub_find_cna_node(cna, &uent->cna_list);
+
+	if (!node)
+		return -ENOENT;
+	node->need_update = true;
+	ub_cna_node_put(node);
+	ub_entity_assign_priv_flag(uent, UB_ENTITY_ROUTE_UPDATED, true);
+	return 0;
+}
+
+static ssize_t __ub_route_override_show(struct ub_entity *uent, char *buf)
+{
+	struct ub_route_override *override;
+	ssize_t len = 0;
+
+	mutex_lock(&ub_route_override_lock);
+	list_for_each_entry(override, &ub_route_overrides, node) {
+		if (override->src_uent_num != uent->uent_num)
+			continue;
+		len += sysfs_emit_at(buf, len,
+			"mode=%s src_uent=%u relay_uent=%u dst_uent=%u dst_cna=%u\n",
+			override->mode == UB_ROUTE_OVERRIDE_FORCE ? "force" : "add",
+			override->src_uent_num, override->relay_uent_num,
+			override->dst_uent_num, override->dst_cna);
+	}
+	mutex_unlock(&ub_route_override_lock);
+	return len;
 }
 
+static ssize_t __ub_route_override_store(struct ub_entity *src, const char *buf,
+					 size_t count)
+{
+	struct ub_route_override *override, *old = NULL;
+	struct ub_entity *relay = NULL, *dst = NULL;
+	char command[16] = {};
+	u32 relay_num = 0, dst_num = 0;
+	enum ub_route_override_mode mode;
+	int fields, ret;
+
+	fields = sscanf(buf, "%15s %u %u", command, &relay_num, &dst_num);
+	if (fields < 1)
+		return -EINVAL;
+	if (!strcmp(command, "clear")) {
+		if (fields != 2)
+			return -EINVAL;
+		dst_num = relay_num;
+		dst = ub_get_ent_by_uent_num(dst_num);
+		if (!dst)
+			return -ENODEV;
+		mutex_lock(&ub_route_override_lock);
+		override = ub_find_route_override(src->uent_num, dst->cna);
+		if (override)
+			list_del(&override->node);
+		mutex_unlock(&ub_route_override_lock);
+		if (!override) {
+			put_device(&dst->dev);
+			return -ENOENT;
+		}
+		ret = ub_mark_cna_for_sync(src, dst->cna);
+		kfree(override);
+		put_device(&dst->dev);
+		if (ret)
+			return ret;
+		ub_route_sync_dev(src);
+		return count;
+	}
+	if (fields != 3)
+		return -EINVAL;
+	if (!strcmp(command, "force"))
+		mode = UB_ROUTE_OVERRIDE_FORCE;
+	else if (!strcmp(command, "add"))
+		mode = UB_ROUTE_OVERRIDE_ADD;
+	else
+		return -EINVAL;
+
+	relay = ub_get_ent_by_uent_num(relay_num);
+	dst = ub_get_ent_by_uent_num(dst_num);
+	if (!relay || !dst) {
+		ret = -ENODEV;
+		goto put_devices;
+	}
+	ret = ub_validate_route_override(src, relay, dst);
+	if (ret)
+		goto put_devices;
+	if (mode == UB_ROUTE_OVERRIDE_ADD) {
+		struct ub_port *direct = ub_find_unique_port_to_uent(src, dst->uent_num);
+
+		if (IS_ERR(direct) ||
+		    !ub_native_route_uses_port(src, dst->cna, direct->index)) {
+			ret = -ENOLINK;
+			goto put_devices;
+		}
+	}
+	override = kzalloc(sizeof(*override), GFP_KERNEL);
+	if (!override) {
+		ret = -ENOMEM;
+		goto put_devices;
+	}
+	override->src_uent_num = src->uent_num;
+	override->relay_uent_num = relay->uent_num;
+	override->dst_uent_num = dst->uent_num;
+	override->dst_cna = dst->cna;
+	override->mode = mode;
+	mutex_lock(&ub_route_override_lock);
+	old = ub_find_route_override(src->uent_num, dst->cna);
+	if (old)
+		list_replace(&old->node, &override->node);
+	else
+		list_add_tail(&override->node, &ub_route_overrides);
+	mutex_unlock(&ub_route_override_lock);
+	kfree(old);
+	ret = ub_mark_cna_for_sync(src, dst->cna);
+	if (!ret)
+		ub_route_sync_dev(src);
+put_devices:
+	if (relay)
+		put_device(&relay->dev);
+	if (dst)
+		put_device(&dst->dev);
+	return ret ? ret : count;
+}
+
+ssize_t ub_route_override_show(struct ub_entity *uent, char *buf)
+{
+	ssize_t ret;
+
+	down_read(&ub_bus_sem);
+	ret = __ub_route_override_show(uent, buf);
+	up_read(&ub_bus_sem);
+	return ret;
+}
+
+ssize_t ub_route_override_store(struct ub_entity *uent, const char *buf,
+				size_t count)
+{
+	ssize_t ret;
+
+	down_write(&ub_bus_sem);
+	ret = __ub_route_override_store(uent, buf, count);
+	up_write(&ub_bus_sem);
+	return ret;
+}
