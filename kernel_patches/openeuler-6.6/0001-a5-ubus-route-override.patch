+enum ub_route_override_mode {
+	UB_ROUTE_OVERRIDE_FORCE,
+	UB_ROUTE_OVERRIDE_ADD,
+};
+
+struct ub_route_override {
+	u32 src_uent_num;
+	u32 relay_uent_num;
+	u32 dst_uent_num;
+	u32 dst_cna;
+	enum ub_route_override_mode mode;
+	struct list_head node;
+};
+
+static LIST_HEAD(ub_route_overrides);
+static DEFINE_MUTEX(ub_route_override_lock);
+
+static struct ub_port *ub_find_unique_port_to_uent(struct ub_entity *src,
+						   u32 remote_uent_num)
+{
+	struct ub_port *port, *found = NULL;
+
+	for_each_uent_port(port, src) {
+		if (!port->r_uent || port->r_uent->uent_num != remote_uent_num)
+			continue;
+		if (port->link_state != LINK_STATE_NORMAL)
+			continue;
+		if (found) {
+			ub_err(src, "multiple active ports reach uent %#x; refuse ambiguous override\n",
+			       remote_uent_num);
+			return ERR_PTR(-ENOTUNIQ);
+		}
+		found = port;
+	}
+	return found ?: ERR_PTR(-ENOLINK);
+}
+
+static bool ub_native_route_uses_port(struct ub_entity *src, u32 dst_cna,
+					      u16 port_index)
+{
+	struct ub_port *port;
+
+	for_each_uent_port(port, src)
+		if (port->index == port_index)
+			return test_bit(dst_cna, port->cna_maps);
+	return false;
+}
+
+static struct ub_route_override *ub_find_route_override(u32 src_uent_num,
+							u32 dst_cna)
+{
+	struct ub_route_override *override;
+
+	list_for_each_entry(override, &ub_route_overrides, node)
+		if (override->src_uent_num == src_uent_num &&
+		    override->dst_cna == dst_cna)
+			return override;
+	return NULL;
+}
+
+static int ub_apply_route_override(struct ub_entity *uent, u32 dst_cna,
+					   unsigned long *entry)
+{
+	struct ub_route_override *override;
+	struct ub_port *relay_port;
+	int ret = 0;
+
+	mutex_lock(&ub_route_override_lock);
+	override = ub_find_route_override(uent->uent_num, dst_cna);
+	if (!override)
+		goto out;
+	relay_port = ub_find_unique_port_to_uent(uent, override->relay_uent_num);
+	if (IS_ERR(relay_port)) {
+		ret = PTR_ERR(relay_port);
+		goto out;
+	}
+	if (override->mode == UB_ROUTE_OVERRIDE_FORCE)
+		bitmap_zero(entry, UB_ROUTE_TABLE_ENTRY_BITS);
+	set_bit(relay_port->index, entry);
+	pr_info("override mode=%s src=%#x dst_uent=%#x dst_cna=%#x relay=%#x port=%u\n",
+		override->mode == UB_ROUTE_OVERRIDE_FORCE ? "force" : "add",
+		override->src_uent_num, override->dst_uent_num, dst_cna,
+		override->relay_uent_num, relay_port->index);
+out:
+	mutex_unlock(&ub_route_override_lock);
+	return ret;
+}
+
